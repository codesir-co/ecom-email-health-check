#. Plugin Name of the plugin
#: ecom-email-health-check.php
msgid "Email Health Check & Log for WooCommerce – SPF, DKIM, DMARC & Alerts"
msgstr "فحص صحة البريد الإلكتروني وسجله لـ WooCommerce – SPF وDKIM وDMARC والتنبيهات"

#. Plugin URI of the plugin
#: ecom-email-health-check.php
msgid "https://github.com/codesir-co/ecom-email-health-check"
msgstr "https://github.com/codesir-co/ecom-email-health-check"

#. Description of the plugin
#: ecom-email-health-check.php
msgid "Email log, SPF/DKIM/DMARC checks and failure alerts. Find out why WooCommerce order emails go to spam or never arrive."
msgstr "سجل البريد الإلكتروني وفحوص SPF/DKIM/DMARC وتنبيهات الفشل. اكتشف لماذا تذهب رسائل طلبات WooCommerce إلى البريد المزعج أو لا تصل أبدًا."

#. Author of the plugin
#: ecom-email-health-check.php
msgid "CodeSir"
msgstr "CodeSir"

